<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
      <DefineConstants>TRACE;UNITY_DOTSPLAYER;DOTNET</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
      <DefineConstants>TRACE;UNITY_DOTSPLAYER;DOTNET</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.0"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0"/>
        <PackageReference Include="NUnit" Version="3.14.0"/>
        <PackageReference Include="NUnit.Analyzers" Version="3.9.0"/>
        <PackageReference Include="NUnit3TestAdapter" Version="4.5.0"/>
        <PackageReference Include="CommandLineParser" Version="2.8.0" />
        <PackageReference Include="MemoryPack" Version="1.10.0" />
        <PackageReference Include="MongoDB.Driver" Version="2.17.1" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\Unity\Assets\Scripts\Base\**\*.cs">
            <Link>Scripts\Base\%(RecursiveDir)%(FileName)%(Extension)</Link>
        </Compile>

        <Compile Include="..\..\Unity\Assets\Scripts\Core\**\*.cs">
            <Link>Scripts\Core\%(RecursiveDir)%(FileName)%(Extension)</Link>
        </Compile>

        <Compile Include="..\..\Unity\Assets\Scripts\ThirdParty\**\*.cs">
            <Link>Scripts\ThirdParty\%(RecursiveDir)%(FileName)%(Extension)</Link>
        </Compile>

        <Compile Include="..\..\Unity\Assets\Scripts\Model\Shard\AOI\**\*.cs">
            <Link>Scripts\Model\Shard\AOI\%(RecursiveDir)%(FileName)%(Extension)</Link>
        </Compile>

        <Compile Include="..\..\Unity\Assets\Scripts\Logic\Shard\AOI\**\*.cs">
            <Link>Scripts\Logic\Shard\AOI\%(RecursiveDir)%(FileName)%(Extension)</Link>
        </Compile>

        <Compile Include="..\..\Unity\Assets\Scripts\Model\Shard\Demo\Gameplay\LevelGameWorldComponent.cs">
            <Link>Scripts\Model\Shard\Demo\Gameplay\LevelGameWorldComponent.cs</Link>
        </Compile>

        <Compile Include="..\..\Unity\Assets\Scripts\Logic\Shard\Demo\Map\LevelSceneFactory.cs">
            <Link>Scripts\Logic\Shard\Demo\Map\LevelSceneFactory.cs</Link>
        </Compile>

        <Compile Include="..\..\Unity\Assets\Scripts\Model\Shard\EventTypes\Event_AfterCreateLevelScene.cs">
            <Link>Scripts\Model\Shard\EventTypes\Event_AfterCreateLevelScene.cs</Link>
        </Compile>

        <Compile Include="..\..\Unity\Assets\Scripts\Model\Shard\Demo\Gameplay\GameplayWorldUpdater.cs">
            <Link>Scripts\Model\Shard\Demo\Gameplay\GameplayWorldUpdater.cs</Link>
        </Compile>

        <Compile Include="..\..\Unity\Assets\Scripts\Model\Shard\Demo\Gameplay\GameplayWorld.cs">
            <Link>Scripts\Model\Shard\Demo\Gameplay\GameplayWorld.cs</Link>
        </Compile>

        <Compile Include="..\..\Unity\Assets\Scripts\Model\Shard\Demo\Gameplay\GameplayWorldTimer.cs">
            <Link>Scripts\Model\Shard\Demo\Gameplay\GameplayWorldTimer.cs</Link>
        </Compile>

        <Compile Include="..\..\Unity\Assets\Scripts\Model\Shard\Demo\Gameplay\GameplayWorldLogicPriority.cs">
            <Link>Scripts\Model\Shard\Demo\Gameplay\GameplayWorldLogicPriority.cs</Link>
        </Compile>

        <Compile Include="..\..\Unity\Assets\Scripts\Model\Shard\Demo\Gameplay\GameplayWorldLogicUpdateException.cs">
            <Link>Scripts\Model\Shard\Demo\Gameplay\GameplayWorldLogicUpdateException.cs</Link>
        </Compile>

        <Compile Include="..\..\Unity\Assets\Scripts\Model\Shard\Demo\Gameplay\GamePlayEntity.cs">
            <Link>Scripts\Model\Shard\Demo\Gameplay\GamePlayEntity.cs</Link>
        </Compile>

        <Compile Include="..\..\Unity\Assets\Scripts\Model\Shard\Demo\Gameplay\GameplayWorldFactory.cs">
            <Link>Scripts\Model\Shard\Demo\Gameplay\GameplayWorldFactory.cs</Link>
        </Compile>

        <Compile Include="..\..\Unity\Library\PackageCache\com.unity.mathematics*\Unity.Mathematics\**\*.cs">
            <Link>Unity.Mathematics/$([System.String]::new(%(RecursiveDir)).Substring($([System.String]::new(%(RecursiveDir)).Indexof("Unity.Mathematics"))).Replace("Unity.Mathematics", ""))/%(FileName)%(Extension)</Link>
        </Compile>

        <Compile Update="..\..\Unity\Library\PackageCache\com.unity.mathematics@1.2.6\Unity.Mathematics\PropertyAttribute.cs">
          <Link>Unity.Mathematics\PropertyAttribute.cs</Link>
        </Compile>

        <Compile Update="Unity.Mathematics\PropertyAttribute.cs">
          <Link>Unity.Mathematics\PropertyAttribute.cs</Link>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Bliss.ProjectRule\Bliss.ProjectRule\Bliss.ProjectRule.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
