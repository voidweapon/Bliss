# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

#IDE文件
*.vs/
*.idea/
*.vscode/
_ReSharper.CSharp/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
/Unity/sysinfo.txt
/Unity/mono_crash*.blob

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
*.bkp

#svn
*/.svn/
.svn/

#Excel的临时文件
~$*.xlsx
~$*.xlsx.meta

#Unity相关目录
/Unity/UserSettings
/Unity/Bundles
/Unity/XCodeProject
/Unity/HybridCLRData
/Unity/Release
/Unity/ScenePhysicalData
/Unity/Unity_BurstDebugInformation_DoNotShip
/Unity/Logs
/Unity/*.csproj
/Unity/*.unityproj
/Unity/*.sln
/Unity/mono_crash.*.json

#Unity/Assets
/Unity/Assets/Res/Code
Unity/Assets/StreamingAssets/
Unity/Assets/StreamingAssets.meta

# Benchmark 
/BlissBenchMark/.idea
/BlissBenchMark/.vs
/BlissBenchMark/BenchmarkDotNet.Artifacts
/Tools/Configs/Generate

#其他
/Bin
bin/
/Tools/ProtoGenerator/Generate
/Bliss.UnitTest/Bliss.UnitTest/TestResults
*.meta
