
<module name="Gameplay">


<bean name="SkillStage">
  <var name="id" type="int"/>
  <var name="gameAction" type="string"/>
  <var name="moveInput" type="int"/>
  <var name="inputAction" type="int"/>
  <var name="tagCondition" type="int"/>
  <var name="enterTag" type="(list#sep=;),string"/>
  <var name="notEnterTag" type="(list#sep=|),string"/>
  <var name="reasource" type="int"/>
  <var name="priority" type="int"/>
  <var name="faceTarget" type="bool"/>
</bean>



</module>
