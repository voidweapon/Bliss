
<module name="Gameplay">

<bean name="ACondition">
<var name="name" type="string"/>
</bean>

<bean name="ATagQueryCondition" parent="ACondition">

</bean>

<bean name="ATagQueryTagCondition" parent="ATagQueryCondition">
  <var name="tags" type="(list#sep=,),string"/>
</bean>

<bean name="ATagQueryExprCondition" parent="ATagQueryCondition">
  <var name="exprs" type="(list#sep=,),int"/>
</bean>

<bean name="TagQuery_AnyTagsMatch" parent="ATagQueryTagCondition">
</bean>

<bean name="TagQuery_AllTagsMatch" parent="ATagQueryTagCondition">
</bean>

<bean name="TagQuery_NoTagsMatch" parent="ATagQueryTagCondition">
</bean>

<bean name="TagQuery_AnyExprMatch" parent="ATagQueryExprCondition">
</bean>

<bean name="TagQuery_AllExprMatch" parent="ATagQueryExprCondition">
</bean>

<bean name="TagQuery_NoExprMatch" parent="ATagQueryExprCondition">
</bean>


</module>
