<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>12</LangVersion>
        <Nullable>enable</Nullable>
        <DevelopmentDependency>true</DevelopmentDependency>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IncludeSymbols>false</IncludeSymbols>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <NoWarn>RS2008</NoWarn>
        <PackageScribanIncludeSource>true</PackageScribanIncludeSource>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <OutputPath>obj/Debug</OutputPath>
        <DefineConstants>TRACE;PROJECT_RULE_TEST</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <OutputPath>obj/Release</OutputPath>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="3.8.0" PrivateAssets="all"/>
        <PackageReference Update="NETStandard.Library" PrivateAssets="all" />
        <PackageReference Include="Scriban" Version="6.2.1" IncludeAssets="Build"/>
        <PackageReference Include="Microsoft.CSharp" Version="4.5.0" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="3.8.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.3">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    
    <ItemGroup>
        <Compile Include="../../Unity/Assets/Scripts/Base/Analyzer/**/*.cs">
            <PrivateAssets>all</PrivateAssets>
            <Link>AnalyzerAttribute/%(RecursiveDir)%(FileName)%(Extension)</Link>
        </Compile>
        <Compile Include="../../Unity/Assets/Scripts/Core/AnalyzerAttribute/**/*.cs">
            <PrivateAssets>all</PrivateAssets>
            <Link>AnalyzerAttribute/%(RecursiveDir)%(FileName)%(Extension)</Link>
        </Compile>
        <Compile Include="../../Unity/Assets/Scripts/Core/Entity/EntitySystems/IEntitySystemConstraint.cs">
            <PrivateAssets>all</PrivateAssets>
            <Link>AnalyzerAttribute/%(RecursiveDir)%(FileName)%(Extension)</Link>
        </Compile>
    </ItemGroup>
    
    <Target Name="CustomAfterBuild" AfterTargets="Build" Condition=" '$(Configuration)' == 'Release' ">
        <Message Text = "Copy $(TargetDir)/$(TargetName).dll -> $(ProjectDir)/../../Unity/Assets/CodeAnalyzer/$(TargetName).dll"  Importance="High"/>
        <Copy SourceFiles="$(TargetDir)/$(TargetName).dll" DestinationFiles="$(ProjectDir)/../../Unity/Assets/CodeAnalyzer/$(TargetName).dll" ContinueOnError="false" xmlns="" />
    </Target>
</Project>
