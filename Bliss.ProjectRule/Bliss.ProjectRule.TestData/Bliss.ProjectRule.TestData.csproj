<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bliss.ProjectRule\Bliss.ProjectRule.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer"/>

        <Compile Include="../../Unity/Assets/Scripts/Base/Analyzer/**/*.cs">
            <Link>Analyzer/Attributes/%(RecursiveDir)%(FileName)%(Extension)</Link>
        </Compile>
        <Compile Include="../../Unity/Assets/Scripts/Core/AnalyzerAttribute/**/*.cs">
            <Link>Analyzer/Attributes/%(RecursiveDir)%(FileName)%(Extension)</Link>
        </Compile>
    </ItemGroup>

</Project>
